                    "null"
                  ]
                },
                "employer_size": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role_title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role_category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role_levels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "employer_address_line_one": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "employer_address_line_two": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "employer_city": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "employer_state_province_county": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "employer_postal_code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "employer_country": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "started_on": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "ended_on": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "summary": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "employer_name",
                "employer_linkedin_url",
                "employer_website",
                "employer_type",
                "employer_size",
                "role_title",
                "role_category",
                "role_levels",
                "employer_address_line_one",
