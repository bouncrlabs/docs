                        "null"
                      ]
                    },
                    "type": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "size": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "address_line_one": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "address_line_two": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "city": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "state_province_county": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "postal_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "country": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "linkedin_url",
                    "website",
                    "type",
                    "size",
                    "address_line_one",
                    "address_line_two",
                    "city",
                    "state_province_county",
                    "postal_code",
                    "country"
                  ]
                },
                "role": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "category": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "levels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "title",
                    "category",
                    "levels"
                  ]
                }
              },
              "required": [
                "started_on",
                "ended_on",
                "summary",
                "employer",
                "role"
              ]
            }
          }
        },
        "required": [
          "aliases",
          "addresses",
          "contacts",
          "demographics",
          "educations",
          "employments"
        ]
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "TYPE_UNSPECIFIED",
          "TYPE_UNKNOWN",
          "TYPE_DRIVERS_LICENSE",
          "TYPE_ENHANCED_DRIVERS_LICENSE",
          "TYPE_STATE_ID",
          "TYPE_PASSPORT_BOOK",
          "TYPE_PASSPORT_CARD",
