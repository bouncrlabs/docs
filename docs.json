{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bouncr",
  "colors": {
    "primary": "#e2503f",
    "light": "#e2503f",
    "dark": "#e2503f"
  },
  "favicon": {
    "light": "/images/bouncr-logo-light.svg",
    "dark": "/images/bouncr-logo-dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "external/overview",
          "external/backend",
          "external/web"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "external/customize",
          "external/resume",
          "external/recovery",
          "external/results",
          "external/testing"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "external/reference"
        ]
      },
      {
        "group": "HTTP API",
        "pages": [
          "external/api-reference",
          "external/api/create-scan",
          "external/api/create-token",
          "external/api/get-scan",
          "external/api/list-scans"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/bouncr-word-mark-light.svg",
    "dark": "/images/bouncr-word-mark-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@bouncrlabs.com"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/bouncr-labs",
      "github": "https://github.com/bouncrlabs",
      "website": "https://bouncrlabs.com"
    }
  },
  "appearance": {
    "strict": false
  },
  "api": {
    "openapi": [
      "openapi.json"
    ],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "autogenerate": true,
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "description": "Build real-time ID verification into your product with Bouncr Labs SDKs"
}
