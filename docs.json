{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bouncr",
  "colors": {
    "primary": "#e2503f",
    "light": "#e2503f",
    "dark": "#e2503f"
  },
  "favicon": {
    "light": "/images/svgviewer-output%20%281%29_transparent.svg",
    "dark": "/images/svgviewer-output%20%281%29_transparent.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "external/overview",
          "external/backend",
          "external/web"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "external/customize",
          "external/resume",
          "external/recovery",
          "external/results"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "external/reference"
        ]
      },
      {
        "group": "HTTP API",
        "pages": [
          "external/api-reference",
          "external/api/create-scan",
          "external/api/create-token",
          "external/api/get-scan",
          "external/api/list-scans"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/vectorized_019d164c-78ce-7a43-83dd-5c205bf6fb04_transparent.svg",
    "dark": "/images/vectorized_019d164c-78ce-7a43-83dd-5c205bf6fb04_transparent.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@bouncrlabs.com"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/bouncr-labs"
    }
  },
  "appearance": {
    "strict": true
  },
  "api": {
    "openapi": [
      "openapi.json"
    ],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "autogenerate": true,
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": true
    }
  }
